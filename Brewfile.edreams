# eDreams-profile overlay: company-only tooling. Never installed on personal
# machines.

# Containers without Docker Desktop (no company license needed)
brew "colima"
brew "docker" # CLI client for the colima runtime
brew "docker-compose" # `docker compose` plugin; wired up by install.sh

cask "gcloud-cli"
cask "cursor"
cask "dbeaver-community"

# slack comes preinstalled via the company MDM profile
# cask "slack"
