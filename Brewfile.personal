# Personal-profile overlay: homelab, media, licensed apps and anything tied
# to personal accounts. Never installed on work machines.

tap "grishka/grishka" # neardrop

# --- Homelab / infra ---
brew "cloud-sql-proxy"
brew "drone-cli"
brew "kubeseal"
brew "opentofu"
brew "talhelper"
brew "velero"
brew "wireguard-tools"
cask "gcloud-cli"
cask "tigervnc"

# --- CLI utilities ---
brew "adb-enhanced"
brew "ffuf"
brew "jmeter"
brew "mas"
brew "mat2"
brew "nmap"
brew "poppler-qt5"
brew "squashfs"
brew "tesseract-lang"

# --- Dev apps ---
# android-platform-tools: disabled 2026-08 — upstream checksum mismatch
# (Google republished the zip). Re-enable when the cask is fixed; meanwhile
# adb ships with Android Studio's SDK.
# cask "android-platform-tools"
cask "android-studio"
cask "chatgpt"
cask "claude"
cask "http-toolkit"
cask "mitmproxy"
cask "mqttx"
cask "ngrok"
cask "ollama-app"
cask "opencode-desktop"
cask "utm"

# --- Desktop environment ---
cask "betterdisplay"
cask "cleanshot"
cask "jordanbaird-ice"
cask "karabiner-elements"
cask "logi-options+"
cask "loop"
cask "xnapper"

# --- Internet / communication ---
cask "adguard"
cask "discord"
cask "syncthing-app"
cask "tailscale-app"

# --- Media / entertainment ---
cask "battle-net"
cask "jdownloader"
cask "moonlight"
cask "obs"
cask "plex"
cask "spotify"
cask "steam"

# --- System tools ---
cask "balenaetcher"
cask "macfuse"
cask "mountmate"
cask "neardrop"
cask "wispr-flow"

# --- Misc ---
cask "autofirma"
cask "focusrite-control"
cask "parallels"
cask "windows-app" # formerly microsoft-remote-desktop

# Licensed / heavyweight apps intentionally not auto-installed:
# cask "ableton-live-suite"
# cask "gpg-suite" # legacy GPG stack; commit signing uses SSH keys now

# --- Mac App Store ---
mas "Amphetamine", id: 937984704
mas "Infuse", id: 1136220934
mas "The Unarchiver", id: 425424353
# mas "WireGuard", id: 1451685025
