[user]
	name = rubasace
	email = ruben.pahino.verdugo@gmail.com
	signingkey = ~/.ssh/id_ed25519_git_signing.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = master
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[pull]
	ff = only
[core]
	excludesFile = ~/.config/git/ignore
